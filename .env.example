# Copy to .env and adjust for local development.
# All EXPO_PUBLIC_* vars are bundled into the client at build time — never
# put secrets here. AI provider keys live only on the backend.

# Base URL of the LifeFix backend (not implemented yet).
EXPO_PUBLIC_API_URL=https://api.lifefix.ai

# When "true", uses RemoteAIService (requires the backend above to exist).
# Defaults to "false", which uses the local MockAIService for development.
EXPO_PUBLIC_USE_REMOTE_AI=false
