# Copy to .env and adjust for local development.
#
# Two very different kinds of variables live here — do not mix them up:
#
#   EXPO_PUBLIC_*  -> bundled into the CLIENT app. Anyone can read these
#                     out of a shipped build. NEVER put a secret here.
#
#   everything else -> read only by server code (backend/**, imported only
#                     from app/analyze+api.ts). Expo Router bundles API
#                     routes into a separate server target that never
#                     reaches the mobile client bundle, so these are safe
#                     to use for real secrets.

# ---- Client (mobile app) ----

# Base URL the app calls for its own backend. Leave unset/empty for local
# dev on web and native (resolves as a relative path against the Expo dev
# server, which also serves the /analyze API route). Set to your deployed
# backend's absolute URL for a native production build.
EXPO_PUBLIC_API_URL=

# Set to "true" to opt into the real backend (RemoteAIService) instead of
# the local MockAIService. Defaults to Mock — no network call, no AI
# provider, no cost — per an explicit product decision to develop against
# simulated data for now. Only flip this on once you're ready to pay for
# real Anthropic usage (needs ANTHROPIC_API_KEY set below, server-side).
EXPO_PUBLIC_USE_REMOTE_AI=false

# ---- Server (backend/analyze+api.ts) — only matters if you opted in above ----

# Required for real analyses, i.e. only read when EXPO_PUBLIC_USE_REMOTE_AI
# is "true". Get one at https://console.anthropic.com/ — using it will
# incur real Anthropic API cost. Without this set, POST /analyze returns a
# clear "PROVIDER_NOT_CONFIGURED" error instead of pretending to work.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-opus-5 (see backend/config.ts).
# ANTHROPIC_MODEL=claude-opus-5

# Optional — abuse/cost guardrails for POST /analyze. Defaults shown.
# RATE_LIMIT_PER_MINUTE=8
# RATE_LIMIT_PER_DAY=60

# Optional — max time (ms) to wait on the AI provider before failing with
# a TIMEOUT error. Default shown.
# ANALYSIS_TIMEOUT_MS=45000
